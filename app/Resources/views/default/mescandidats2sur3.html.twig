<!-- Code qui s'exécute quand j'ouvre la Modale-->
<SCRIPT type="text/javascript">
    $('#ModaleSupprimer').on('shown.bs.modal', function () {
        $('#myInput').trigger('focus');

        var formulaire = document.getElementById('formModale');
        formulaire.setAttribute("action", "../deleteCandidat/"+window.idSuppression);
        idSuppression=0;

    })
</SCRIPT>

<SCRIPT>
    function showOneCandidat(idCandidat)
    {
    	var id = idCandidat;
        url="{{app.request.basePath}}/showOneCandidat/"+ id+"/";
		parent.location.href = url;
    }
</SCRIPT>


