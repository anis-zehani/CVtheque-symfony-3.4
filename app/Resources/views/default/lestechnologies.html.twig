{% include 'default/header.html.twig' %}

<div class="container-fluid" style="height: 88%;background-color: #ffffff;" >
    <div class="row align-items-start" style="background-color: #ffffff;">
    
        <!-- Formulaire Ajout / Modification Technologies-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="../addTechnologie/" method="post" name="formTechnologies" id="formTechnologies">
                <div class="form-group">
                    <label for="nameScreen" style="color: #0073b1;font-size: 16px;font-weight: bold;">Les Technologies :</label>
                </div>

                <div class="form-group"> 
                        <input type="text" class="form-control" id="nom" name="nom" placeholder="Nom de la technologie" required>
                </div>


                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Ajouter une technologie" style="background-color: #0073b1;border: none;"/>
                </div>

                <input type="hidden" id="id" name="id" value="id"/>

            </form>


            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-sm btn-block"  onclick="resetTechnologie();" value="Tout Réinitialiser" style="background-color: #0073b1;border: none;"/>
            </div>
        </div>

        <div class="col-sm-9" style="text-align: left;">

            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                    <th width="10%">Supprimer</th>
                    <th>Nom de la technologie</th>
                    <th width="10%">Modifier</th>
                </tr>
                </thead>
                <tbody>
                {% for key in allTechnologies %}
                    <tr>
                        <td style="text-align:center;background-color: #FFFFFF">
                            <a href="#" onclick="idSuppression={{key.id}}; $('#ModaleTechnologie').modal();"><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        <td>{{ key.nom }}</td>
                        <td style="text-align:center;background-color: #FFFFFF"><a href="#" id="btnModifier" onclick="modifierTechnologie('{{ key.id }}','{{ key.nom |replace({"'": "\\'",'\r\n': '\\r\\n', '\n': '\\n', '\r': '\\r'})}}');"><img src="{{ asset('./bootstrap/img/update.jpg') }}" width="20" height="20" ></a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="form-row">
            <!--------------------------- Feêtre POP-UP la Modale ------------------------------------------------>
            <div class="modal fade" id="ModaleTechnologie" tabindex="-1" role="dialog" aria-labelledby="exampleModaleTechnologieTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="../deleteTechnologie/" method="post" name="formModale" id="formModale">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Supprimer une Technologie</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                Attention, vous êtes sur le point de supprimer cette Technologie.
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider">Valider</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Clique sur l'icône Modifier (dans le tableau Technologies)-->
<SCRIPT>
    function modifierTechnologie(id, nom)
    {
        document.getElementById("id").value = id;
        document.getElementById("nom").value = nom;
        document.getElementById("btnAjouter").value = 'Modifier une Technologie';
        
        var formulaire = document.getElementById('formTechnologies');
        formulaire.setAttribute("action", "../updateTechnologie/");
        
    }
</SCRIPT>
<!-- Clique sur le bouton Reset(dans le formulaire Technologie)-->
<SCRIPT>
    function resetTechnologie()
    {

        document.getElementById("nom").value = '';
        document.getElementById("btnAjouter").value = 'Ajouter une Technologie';
        var formulaire = document.getElementById('formTechnologies');
        formulaire.setAttribute("action", "../addTechnologie/");
    }
</SCRIPT>

<!-- Code qui s'exécute quand j'ouvre la Modale Supprimer Technologie-->
<SCRIPT type="text/javascript">
    $('#ModaleTechnologie').on('shown.bs.modal', function () {
        $('#myInput').trigger('focus');
       
        var formulaire = document.getElementById('formModale');
        formulaire.setAttribute("action", "../deleteTechnologie/"+window.idSuppression+"/");
        idSuppression=0;
       
    })
</SCRIPT>

<!-- Configuration de la DATATABLE-->
<SCRIPT type="text/javascript">
    $(document).ready(function() {
        $('#my_table').DataTable({
            "fixedColumns": true,
            "autoWidth": true,
            "scrollX": true,
            "scrollY": true,
            "language": {
                "sProcessing": "Traitement en cours ...",
                "sLengthMenu": "Afficher _MENU_ lignes",
                "sZeroRecords": "Aucun résultat trouvé",
                "sEmptyTable": "Aucune donnée disponible",
                "sInfo": "Lignes _START_ à _END_ sur _TOTAL_",
                "sInfoEmpty": "Aucune ligne affichée",
                "sInfoFiltered": "(Filtrer un maximum de_MAX_)",
                "sInfoPostFix": "",
                "sSearch": "Chercher :",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Chargement...",
                "oPaginate": {
                    "sFirst": "Premier", "sLast": "Dernier", "sNext": "Suivant", "sPrevious": "Précédent"
                },
                "oAria": {
                    "sSortAscending": ": Trier par ordre croissant", "sSortDescending": ": Trier par ordre décroissant"
                }

            }
        });
    } );
</SCRIPT>


