{% include 'default/header.html.twig' %}

<div class="container-fluid" style="height: 86%;" >
    <div class="row align-items-start">
    	<div class="col-sm-1" style="text-align: left;">
    	</div>
    
        <div class="col-sm-10" style="text-align: left;background-color: #ffffff;">
        
        	<nav aria-label="breadcrumb" style="padding-top:10px;width:100%">
                <ol class="breadcrumb" style="background-color: #cbd7e0;color:#000000;vertical-align:middle;">
                    <li class="breadcrumb-item"><a href="{{app.request.basePath}}/accueil/" style="color:#000000">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{app.request.basePath}}/showAllOpportunites/" style="color:#000000">Mes Opportunités</a></li>
                    <li class="breadcrumb-item active" aria-current="page" style="color:#0073b1">Add Opportunité</li>
                </ol>
            </nav>
            <form action="{{app.request.basePath}}/addOpportunite/" method="POST" name="formAjoutOpportunite" id="formAjoutOpportunite" enctype="multipart/form-data">
            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="text-align:left;font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                    <thead>
                    <tr> 
                        <th style="color:#0073b1">Offre & Responsable</th>
                        <th style="color:#0073b1">Les dates clés</th>
                    </tr>
                    </thead>
                    <tbody>
                    	<tr>
                            <td>
    
                                <input type="text" class="form-control" id="titre" name="titre" placeholder="Titre"><br>
                                <input type="text" class="form-control" id="tjm" name="tjm" placeholder="TJM"><br>
                                <div class="form-group">
    
                                    <select class=form-control id="listePartenaires" name="listePartenaires" style="border-radius: 10px;width: 100%;height:40px" placeholder="Liste Partenaires">
                                        <option value="">Responsable de l'offre</option>
            							    {% for partenaire in allPartenairesLight %}
                                        <option value="{{ partenaire.id }}">{{ partenaire.prenom }} {{ partenaire.nom }}</option>
                                        {% endfor %}
                                    </select>
                        		</div>
                                
                            </td>
                            
                            <td>
                                <label for="dateDemarrageSouhaitee"><h6>Date démarrage souhaitée :</h6></label>
                            	<input type="date" class="form-control" id="dateDemarrageSouhaitee" name="dateDemarrageSouhaitee" required placeholder="Date Démarrage Souhaitée"><br>
                           </td>
                        </tr>
                    </tbody>
                </table>
    			
    			<table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="text-align:left;font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                    <thead>
                    <tr> 
                        <th style="width:40%;color:#0073b1">Candidats potentiels</th>
                        <th style="width:40%;color:#0073b1">Technologies ciblées</th>
                    </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="form-group">
                                    
                                    <select multiple class=form-control id="listeCandidats[]" name="listeCandidats[]" style="border-radius: 10px;width: 100%;height:160px" placeholder="Candidats Potentiels">
            							
            							{% for candidat in allCandidatsLight %}
                                            <option value="{{ candidat.id }}">-{{ candidat.prenom }} {{ candidat.nom }} : {{ candidat.specialite }}</option><br>
                                        {% endfor %}
                                        
                                    </select>
                        		</div>

                    		</td>
                    		
                    		<td>
                                <div class="form-group">
                                    
                                    <select multiple class=form-control id="listeTechnologies[]" name="listeTechnologies[]" style="border-radius: 10px;width: 100%;height:160px" >
            							
            							{% for technologie in allTechnologies %}
                                            <option value="{{ technologie.id }}">{{ technologie.nom }}</option>
                                        {% endfor %}
                                        
                                    </select>
                        		</div>

                    		</td>
         
                        </tr>
                    </tbody>
                </table>
                
                <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="text-align:left;font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                    <thead>
                    <tr>
                        <th style="width:40%;color:#0073b1">Description détaillée</th>
                    </tr>
                    </thead>
                    <tbody>
                        <tr>
                    		
                    		<td>
                    			<textarea class="form-control" rows="6" id="descriptionDetaillee" name="descriptionDetaillee"></textarea><br>
                            </td>
         
                        </tr>
                    </tbody>
                </table>
    
                
                
                <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="text-align:left;font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                    
                    <tbody>
                    	<tr>
                            <td>
                               <div class="form-group">
                     				<input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Enregistrer" style="background-color: #0073b1;border: none;"/>
                			   </div> 
                            </td>
                   		</tr>
                   		
                    </tbody>
                </table>
                
                
                </form>
        </div> 
		
		<div class="col-sm-1" style="text-align: left;">
    	</div>
    </div>
</div>

{% include 'default/footer.html.twig' %}