<SCRIPT>
	//Supprime une Technologie pour un Partenaire
    function removeTechnologie(idPartenaire, idTechnologie)
    {
    	
        $.ajax({
            url : '{{app.request.basePath}}/removeTechnologieForPartenaire/'+idPartenaire+'/'+idTechnologie+'/',
            type : 'GET',
            dataType : 'html',
            success : function(data, statut){
                
            location.reload();
            //var json = JSON.parse(data);
            //console.log(json);

            },

            error : function(resultat, statut, erreur){
                console.log(statut);
                console.log(erreur);
                console.log(resultat);
            }
        });

    }
</SCRIPT>
