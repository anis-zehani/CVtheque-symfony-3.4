                    					{% else %}
                    					<b>Poste : </b>N / A<br>
                                {% endif %}
                                {% if oneContact.telephone is defined %}
                    					<b>Tél : </b>{{ oneContact.telephone }}<br>
                    					{% else %}
                    					<b>Tél : </b>N / A<br>
                                {% endif %}
                                
                                <b>Email :</b> {{ oneContact.email }}<br>
                            </td>
                            
                            <td>
         						{% if oneContact.entreprise is defined %}
                    					<b>Entreprise : </b>{{ oneContact.entreprise }}<br>
                    					{% else %}
                    					<b>Entreprise : </b>N / A<br>
                                {% endif %}
                           </td>
                        </tr>
                    </tbody>
                </table>
    			
