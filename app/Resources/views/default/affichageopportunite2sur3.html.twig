<SCRIPT>
	//Archive une Opportunité
    function archiveOpportunite(idOpportunite)
    {
    	
        $.ajax({
            url : '{{app.request.basePath}}/archiveOneOpportunite/'+idOpportunite+'/',
            type : 'GET',
            dataType : 'html',
            success : function(data, statut){

            location.reload();
            
            //var json = JSON.parse(data);
            //console.log(json);

            },

            error : function(resultat, statut, erreur){
                console.log(statut);
                console.log(erreur);
                console.log(resultat);
            }
        });

    }
</SCRIPT>  

