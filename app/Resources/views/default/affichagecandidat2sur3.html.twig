                        <b>-Tél :</b> {{ detailsCandidat.telephone }}<br>
                        <b>-Email :</b> {{ detailsCandidat.email }}<br>
                        {% if detailsCandidat.dateDeNaissance is defined and detailsCandidat.dateDeNaissance |date("Y") matches '/^\\d+$/'%}
    					<b>-Âge :</b> {{ 2018 - detailsCandidat.dateDeNaissance |date("Y") }} ans<br>
    					{% else %}
    					<b>-Âge :</b> {{ detailsCandidat.dateDeNaissance }}<br>
                        {% endif %}
                        
                        <b>-Situation familiale :</b> {{ detailsCandidat.situationFamiliale }} {% if detailsCandidat.nombreEnfants is not empty %}- {{ detailsCandidat.nombreEnfants }} enfant(s){% endif %}<br>
                        <b>-Adresse :</b> {{ detailsCandidat.adresse }}<br>
                        
                        </td>
                        <td>
                        -{{ detailsCandidat.specialite }}{% if detailsCandidat.entreprise is not empty %} <a href="{{ detailsCandidat.siteWebEntreprise }}" target="_blank">({{ detailsCandidat.entreprise }})</a>{% endif %}<br>
                        <b>-Diplôme(s) :</b> 
                            {% for diplome in detailsCandidat.listeDiplomes %}
                                {{ diplome.nom }}
                            {% endfor %}<br>
                        <b>-Année de graduation :</b> {{ detailsCandidat.anneeGraduation }}<br>
                        <b>-École(s) :</b> 
                            {% for ecole in detailsCandidat.listeEcoles %}
                                {{ ecole.nom }}
                            {% endfor %}<br>
                        <b>-Expérience :</b> {{ 2018 - detailsCandidat.anneeDemarrageCarriere }} an(s)<br> 
                        </td>
                    </tr>
                </tbody>
            </table>
			
