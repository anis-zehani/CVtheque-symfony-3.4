                             			<input type="button" class="btn btn-primary btn-sm btn-block"  id="btnArchiver" value="Activer" onclick="activeCandidat({{ detailsCandidat.id }});" style="background-color: #0073b1;border: none;"/>
                    			   </div>
                               {% endif %}
                            </td>
                   		</tr>
                   		
                    </tbody>
            </table>
        
        

<SCRIPT>
	//Archive un Candidat
    function archiveCandidat(idCandidat)
    {
    	
        $.ajax({
            url : '{{app.request.basePath}}/archiveOneCandidat/'+idCandidat+'/',
            type : 'GET',
            dataType : 'html',
            success : function(data, statut){

            location.reload();
            
            //var json = JSON.parse(data);
            //console.log(json);

            },

            error : function(resultat, statut, erreur){
                console.log(statut);
                console.log(erreur);
                console.log(resultat);
            }
        });

    }
</SCRIPT>  

<SCRIPT>
