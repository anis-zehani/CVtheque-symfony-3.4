{% include 'default/header.html.twig' %}

<div class="container-fluid" style="height: 86%;" >
    <div class="row align-items-start">
    	<div class="col-sm-1" style="text-align: left;">
    	</div>
    
        <div class="col-sm-10" style="text-align: left;background-color: #ffffff;">
            <nav aria-label="breadcrumb" style="padding-top:10px;width:100%">
                	<ol class="breadcrumb" style="background-color: #cbd7e0;color:#000000;vertical-align:middle;">
                    	<li class="breadcrumb-item"><a href="{{app.request.basePath}}/accueil/" style="color:#000000">Accueil</a></li>
                        <li class="breadcrumb-item"><a href="{{app.request.basePath}}/showAllPartenaires/" style="color:#000000">Mes Partenaires</a></li>
                        <li class="breadcrumb-item active" aria-current="page" style="color:#0073b1">Modification partenaire : {{ onePartenaire.prenom }} {{ onePartenaire.nom }}</li>
                    </ol>
            </nav>
            <form action="{{app.request.basePath}}/updatePartenaire/" method="POST" name="formAjoutPartenaire" id="formAjoutPartenaire" enctype="multipart/form-data">
            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="text-align:left;font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                    <thead>
                    <tr> 
                        <th style="color:#0073b1;width:120px">Photo du partenaire</th>
                        <th style="color:#0073b1">Informations & contacts</th>
                        <th style="color:#0073b1">Accès & entreprise</th>
                    </tr>
                    </thead>
                    <tbody>
                    	<tr>
                            <td>
                        		<label for="photoTelechargement"><img src="{{app.request.basePath}}/{{ onePartenaire.photo }}"  width="120px" height="120px" style="cursor: pointer;"></label>
                        		<input type="file" name="photoTelechargement" id="photoTelechargement" >
                            </td>
                            <td>
                                <input type="text" class="form-control" id="prenom" name="prenom" value="{{ onePartenaire.prenom }}" placeholder="Prénom"><br>
                                <input type="text" class="form-control" id="nom" name="nom" value="{{ onePartenaire.nom }}" placeholder="Nom"><br>
                                <input type="text" class="form-control" id="poste" name="poste" value="{{ onePartenaire.poste }}" placeholder="Poste occupé"><br>
                                <input type="text" class="form-control" id="telephone" name="telephone" value="{{ onePartenaire.telephone }}" placeholder="Téléphone"><br>
                                <input type="text" class="form-control" id="email" name="email" value="{{ onePartenaire.email }}" placeholder="Email (UNIQUE)"><br>
                            </td>
                            
                            <td>
                            	<input type="text" class="form-control" id="login" name="login" value="{{ onePartenaire.login }}" placeholder="Login"><br>
                                <input type="text" class="form-control" id="password" name="password" value="{{ onePartenaire.password }}" placeholder="Password"><br>
                            	
                                <div class="form-group">
    
                                    <select class=form-control id="listeEntreprises" name="listeEntreprises" style="border-radius: 10px;width: 100%;height:40px" >
                                        <option value="{{ onePartenaire.idEntreprise }}">{{ onePartenaire.entreprise }}</option>
            							{% for entreprise in allEntreprises %}
            								{% if entreprise.id != onePartenaire.idEntreprise %}
                                        	<option value="{{ entreprise.id }}">{{ entreprise.nom }}</option>
                                        	{% endif %}
                                        {% endfor %}
                                    </select>
                        		</div>
                        		
                        		<label for="type"><h6>Type du profil :</h6></label>
                        		<div class="form-group">
                                    <select class=form-control id="type" name="type" style="border-radius: 10px;width: 100%;height:40px" >
            							
            							<option value="{{ onePartenaire.type }}">{{ onePartenaire.type }}</option>
                                        
            							{% if onePartenaire.type != "Partenaire" %}
                                        	<option value="Partenaire">Partenaire</option>
                                        {% else %}
                                        	<option value="Administrateur">Administrateur</option>
                                        {% endif %}
       
                                    </select>
                        		</div>
                        		
                           </td>
                        </tr>
                    </tbody>
                </table>
    			
    			<table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="text-align:left;font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                    <thead>
                    <tr> 
                        <th style="width:40%;color:#0073b1">Technologies ciblées</th>
                        <th style="width:40%;color:#0073b1">Ajouter technologies</th>
                    </tr>
                    </thead>
                    <tbody>
                        <tr>
                        	<td>
                                {% for technologie in onePartenaire.listeTechnologies %}
                                          -{{ technologie.nom }}<br>
                                {% endfor %}
                    		</td>
                    		
                            <td>
                                <div class="form-group">
                                    
                                    <select multiple class=form-control id="listeTechnologies[]" name="listeTechnologies[]" style="border-radius: 10px;width: 100%;height:160px" >
            							
            							{% for technologie in allTechnologies %}
                                            <option value="{{ technologie.id }}">-{{ technologie.nom }}</option>
                                        {% endfor %}
                                        
                                    </select>
                        		</div>

                    		</td>
         
                        </tr>
                    </tbody>
                </table>
                
                <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="text-align:left;font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                    <thead>
                    <tr> 
                        <th style="width:40%;color:#0073b1">Description détaillée</th>
                    </tr>
                    </thead>
                    <tbody>
                        <tr>
                        	
                    		<td>
                    			<textarea class="form-control" rows="6" id="descriptionDetaillee" name="descriptionDetaillee" >
                    					{% autoescape %}{{ onePartenaire.descriptionDetaillee }}{% endautoescape %}
                    			</textarea><br>
                            </td>
         
                        </tr>
                    </tbody>
                </table>
    
                
                
                <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="text-align:left;font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                    
                    <tbody>
                    	<tr>
                            <td>
                               <div class="form-group">
                               		<input type="hidden" id="id" name="id" value="{{ onePartenaire.id }}"/>
                     				<input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Enregistrer" style="background-color: #0073b1;border: none;"/>
                			   </div> 
                            </td>
                   		</tr>
                   		
                    </tbody>
                </table>
                
                
                </form>
        </div> 
		
		<div class="col-sm-1" style="text-align: left;">
    	</div>
    </div>
</div>

{% include 'default/footer.html.twig' %}